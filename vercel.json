{
  "framework": "nextjs",
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "mvg.golf"
        }
      ],
      "destination": "/mvg",
      "permanent": false
    },
    {
      "source": "/old-path",
      "destination": "/new-path",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}